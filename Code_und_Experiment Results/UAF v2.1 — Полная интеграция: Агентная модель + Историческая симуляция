# УРОВЕНЬ 1: МИКРО — Агентная модель (ваша, оптимизированная)
# ══════════════════════════════════════════════════════════════════════

class MicroCommunity:
    """
    Локальная религиозная община: N агентов с убеждениями (теизм, ритуал).
    Замкнутый AdaptiveLoop: взаимодействие → мутация → замер closure.
    Выход: S, C, I → closure_degree для макроуровня.
    """

    def __init__(self, n: int = 200, name: str = ""):
        self.n = n
        self.name = name
        # beliefs[i] = [теизм(0..1), ритуализм(0..1)]
        self.beliefs = np.column_stack([
            np.random.beta(2, 5, n),
            np.random.beta(1, 4, n),
        ])
        self.hist_cd: List[float] = []
        self.hist_S:  List[float] = []
        self.hist_C:  List[float] = []
        self.hist_I:  List[float] = []

    # ── Вычисление S, C, I из распределения убеждений ──

    def _compute_SCI(self) -> Tuple[float, float, float]:
        b = self.beliefs

        # S = Структура: насколько ритуалы унифицированы (низкая дисперсия ритуализма)
        S = float(np.clip(1.0 - np.var(b[:, 1]) * 6.0, 0.0, 1.0))

        # C = Катализ: плотность культурного обмена
        #   ≈ доля пар агентов с близкими убеждениями (dist < 0.35)
        idx = np.random.choice(self.n, min(400, self.n), replace=False)
        sample = b[idx]
        dists = np.linalg.norm(
            sample[:, None, :] - sample[None, :, :], axis=-1
        )
        C = float(np.clip(np.mean(dists < 0.35) * 2.5, 0.0, 1.0))

        # I = Информация: насколько теистический консенсус высок
        mean_t = np.mean(b[:, 0])
        var_t  = np.var(b[:, 0])
        I = float(np.clip(mean_t * (1.0 - var_t * 8.0), 0.0, 1.0))

        return S, C, I

    @property
    def closure_degree(self) -> float:
        S, C, I = self._compute_SCI()
        return float((S * C * I) ** (1 / 3))

    # ── Один шаг эволюции общины ──

    def step(self, catalysis_boost: float = 0.0,
             info_boost: float = 0.0,
             mutation_rate: float = 0.02):

        n_pairs = self.n * 4

        # Активный экспериментатор (реформатор/пророк)
        experimenter = (
            np.random.randint(self.n)
            if random.random() < 0.04 else -1
        )

        # Взаимодействие
        ii = np.random.randint(0, self.n, n_pairs)
        jj = np.random.randint(0, self.n, n_pairs)
        mask = ii != jj
        ii, jj = ii[mask], jj[mask]

        dists = np.linalg.norm(
            self.beliefs[ii] - self.beliefs[jj], axis=1
        )
        close = dists < (0.4 + catalysis_boost * 0.2)

        rate = 0.08 + catalysis_boost * 0.05
        alpha = np.where(
            (ii == experimenter) | (jj == experimenter), rate * 3, rate
        )

        for k in np.where(close)[0]:
            i_, j_ = ii[k], jj[k]
            a = alpha[k]
            mid = (self.beliefs[i_] + self.beliefs[j_]) / 2
            self.beliefs[i_] += a * (mid - self.beliefs[i_])
            self.beliefs[j_] += a * (mid - self.beliefs[j_])

        # Информационный буст (тексты, откровения)
        if info_boost > 0:
            self.beliefs[:, 0] += info_boost * 0.04 * np.random.randn(self.n)

        # Мутация
        mut = np.random.rand(self.n) < mutation_rate
        self.beliefs[mut] += (np.random.rand(mut.sum(), 2) - 0.5) * 0.25
        self.beliefs = np.clip(self.beliefs, 0.0, 1.0)

        # Запись
        S, C, I = self._compute_SCI()
        cd = float((S * C * I) ** (1 / 3))
        self.hist_cd.append(cd)
        self.hist_S.append(S)
        self.hist_C.append(C)
        self.hist_I.append(I)

    def run(self, steps: int, catalysis_boost: float = 0.0,
            info_boost: float = 0.0):
        for _ in range(steps):
            self.step(catalysis_boost, info_boost)


