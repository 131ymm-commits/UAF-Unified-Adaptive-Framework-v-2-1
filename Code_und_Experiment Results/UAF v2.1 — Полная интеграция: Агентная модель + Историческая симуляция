@dataclass
class HistoricalTradition:
    name:       str
    birth:      int          # год рождения
    color:      str
    sg: float = 0.004        # structure growth rate
    cg: float = 0.004        # catalysis growth rate
    ig: float = 0.004        # information growth rate

    # Состояние (инициализируется при активации)
    S: float = 0.03
    C: float = 0.03
    I: float = 0.03
    followers: float = 0.005
    level: int = 0
    alive: bool = False

    # Микроуровень — локальная община
    community: Optional[MicroCommunity] = field(default=None, repr=False)

    # История
    hist_cd:  List[float] = field(default_factory=list)
    hist_S:   List[float] = field(default_factory=list)
    hist_C:   List[float] = field(default_factory=list)
    hist_I:   List[float] = field(default_factory=list)
    hist_fol: List[float] = field(default_factory=list)
    hist_lvl: List[int]   = field(default_factory=list)

    @property
    def cd(self) -> float:
        return float(np.clip((self.S * self.C * self.I) ** (1 / 3), 0, 1))

    def activate(self):
        self.alive = True
        self.S = 0.04 + random.uniform(0, 0.04)
        self.C = 0.04 + random.uniform(0, 0.04)
        self.I = 0.03 + random.uniform(0, 0.03)
        self.followers = 0.005
        self.community = MicroCommunity(n=150, name=self.name)

    def check_level(self) -> Tuple[bool, int]:
        old = self.level
        c = self.cd
        if   c >= TP_L3 and self.level < 3: self.level = 3
        elif c >= TP_L2 and self.level < 2: self.level = 2
        elif c >= TP_L1 and self.level < 1: self.level = 1
        return (self.level > old, old)

    def record(self):
        self.hist_cd.append(self.cd)
        self.hist_S.append(self.S)
        self.hist_C.append(self.C)
        self.hist_I.append(self.I)
        self.hist_fol.append(self.followers)
        self.hist_lvl.append(self.level)


@dataclass
class TPEvent:
    year: int
    name: str
    old_level: int
    new_level: int
    cd: float


