    from matplotlib.gridspec import GridSpec
    gs = GridSpec(4, 3, figure=fig, hspace=0.38, wspace=0.32)

    # ═══ ROW 1: Counterfactual CD comparison ═══

    # Panel 1: CD dynamics — Baseline vs No Axial Age
    ax1 = fig.add_subplot(gs[0, 0])
