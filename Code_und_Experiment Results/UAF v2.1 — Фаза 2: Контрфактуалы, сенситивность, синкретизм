def run_counterfactuals():
    """
    Запускает базовый сценарий и 4 контрфактуала.
    Сравнивает итоговые CD и моменты tipping points.
    """
    scenarios = {
        'Baseline (real history)':   {},
        'No Axial Age':              {'no_axial_age': True},
        'No Constantine':            {'no_constantine': True},
        'No Reformation':            {'no_reformation': True},
        'No Ashoka (Buddhism)':      {'no_ashoka': 1.0},
    }

    results = {}
    for name, mods in scenarios.items():
        eng = HistoryEngine(modifications=mods, label=name)
        eng.run()
        results[name] = eng

    return results


def print_counterfactual_comparison(results: Dict[str, HistoryEngine]):
    """Печатает сравнительную таблицу контрфактуалов"""
    baseline = results['Baseline (real history)']

    print("=" * 80)
    print("  КОНТРФАКТУАЛЬНЫЙ АНАЛИЗ  ·  UAF Phase 2")
    print("=" * 80)

    # ── Итоговые CD по сценариям ──
    print("\n  ИТОГОВЫЕ Closure Degree (2050 н.э.):")
    print("  " + "-" * 76)
    header = f"  {'Традиция':<20s}"
    for scenario in results:
        short = scenario[:12]
        header += f" | {short:>12s}"
    print(header)
    print("  " + "-" * 76)

    for t in baseline.traditions:
        if not t.alive:
            continue
        row = f"  {t.name:<20s}"
        base_cd = t.cd
        for scenario, eng in results.items():
            st = [x for x in eng.traditions if x.name == t.name][0]
            cd_val = st.cd if st.alive else 0.0
            delta = cd_val - base_cd
            if scenario == 'Baseline (real history)':
                row += f" | {cd_val:8.3f}    "
            else:
                sign = "+" if delta >= 0 else ""
                row += f" | {cd_val:5.3f}({sign}{delta:+.3f})"
        print(row)

    # ── Скорость L2 для каждого сценария ──
    print(f"\n  СКОРОСТЬ ЗАМЫКАНИЯ (год рождения -> L2, лет):")
    print("  " + "-" * 76)
    header2 = f"  {'Традиция':<20s}"
    for scenario in results:
        short = scenario[:12]
        header2 += f" | {short:>12s}"
    print(header2)
    print("  " + "-" * 76)

    for t in baseline.traditions:
        if not t.alive:
            continue
        row = f"  {t.name:<20s}"
        base_dt = None
        for scenario, eng in results.items():
            l2_evts = [e for e in eng.tp_log
                       if e.name == t.name and e.new >= 2]
            if l2_evts:
                dt = l2_evts[0].year - t.birth
                if scenario == 'Baseline (real history)':
                    base_dt = dt
                    row += f" | {dt:8d}    "
                elif base_dt is not None:
                    diff = dt - base_dt
                    sign = "+" if diff >= 0 else ""
                    row += f" | {dt:5d}({sign}{diff:+d})"
                else:
                    row += f" | {dt:12d}"
            else:
                row += f" | {'N/A':>12s}"
        print(row)

    print("=" * 80)
    return results


