@dataclass
class Tradition:
    name: str
    birth: int
    color: str
    sg: float; cg: float; ig: float
    tp1: float; tp2: float; tp3: float
    S: float = 0.04; C: float = 0.04; I: float = 0.03
    fol: float = 0.005; level: int = 0; alive: bool = False
    h_cd:  list = field(default_factory=list)
    h_fol: list = field(default_factory=list)
    h_lvl: list = field(default_factory=list)
    h_s:   list = field(default_factory=list)
    h_c:   list = field(default_factory=list)
    h_i:   list = field(default_factory=list)

    @property
    def cd(self):
        return float(np.clip((self.S * self.C * self.I) ** (1/3), 0, 1))

    def snapshot(self) -> dict:
        return {'S': self.S, 'C': self.C, 'I': self.I,
                'fol': self.fol, 'level': self.level, 'alive': self.alive}


@dataclass
class TPEvent:
    year: int; name: str; old: int; new: int; cd: float


class HistoryEngine:
    """
    Параметризованный движок исторической эволюции.
    Поддерживает модификацию каталитических событий
    для контрфактуальных экспериментов.
    """

    def __init__(self, modifications: Optional[Dict] = None, label: str = ""):
        self.t0, self.t1, self.dt = -3000, 2050, 10
        self.years = list(range(self.t0, self.t1 + 1, self.dt))
        self.label = label
        self.mods = modifications or {}
        self.tp_log: List[TPEvent] = []
        self.traditions = self._make_traditions()

    def _make_traditions(self) -> List[Tradition]:
        return [
            Tradition("Mesopot. polyth.",  -3000, "#DAA520",
                      0.0030, 0.0020, 0.0025, 0.18, 0.42, 0.70),
            Tradition("Hinduism",          -1500, "#FF6347",
                      0.0040, 0.0030, 0.0050, 0.20, 0.46, 0.72),
            Tradition("Judaism",           -1200, "#4169E1",
                      0.0050, 0.0035, 0.0065, 0.20, 0.45, 0.71),
            Tradition("Chinese phil.",      -600, "#FF4444",
                      0.0055, 0.0060, 0.0065, 0.22, 0.48, 0.74),
            Tradition("Buddhism",           -500, "#FFA500",
                      0.0060, 0.0065, 0.0055, 0.20, 0.44, 0.70),
            Tradition("Christianity",         30, "#00CC66",
                      0.0075, 0.0085, 0.0070, 0.18, 0.40, 0.66),
            Tradition("Islam",              622, "#22BBAA",
                      0.0090, 0.0100, 0.0085, 0.18, 0.38, 0.64),
            Tradition("Science",           1500, "#BB44FF",
                      0.0110, 0.0130, 0.0170, 0.20, 0.44, 0.70),
        ]

    def _catalyze(self, t: Tradition, y: int):
        mod = self.mods  # shortcut
        n = t.name

        # ── Axial Age ──
        axial_disabled = mod.get('no_axial_age', False)
        if not axial_disabled:
            if -800 <= y <= -200 and n in ["Hinduism", "Judaism",
                                            "Chinese phil.", "Buddhism"]:
                t.C += 0.0025; t.I += 0.0035

        # ── Mesopotamia ──
        if "Meso" in n:
            if -2500 <= y <= -1500: t.S += 0.002
            if y > -500: t.S *= 0.996; t.C *= 0.994
            if y > 100: t.fol *= 0.990

        # ── Judaism ──
        if "Juda" in n:
            if y == -960: t.S += 0.06
            if -500 <= y <= -400: t.I += 0.06
            if y == 70: t.S *= 0.65; t.C += 0.04

        # ── Hinduism ──
        if "Hindu" in n:
            if -600 <= y <= -200: t.I += 0.004
            if 300 <= y <= 600: t.S += 0.003

        # ── Buddhism ──
        if "Buddh" in n:
            if y == -260:
                boost = mod.get('no_ashoka', 0.0)
                t.C += 0.08 * (1 - boost)
                t.S += 0.05 * (1 - boost)
            if 50 <= y <= 500: t.C += 0.002

        # ── Chinese ──
        if "Chinese" in n:
            if y == -200: t.S += 0.07
            if 600 <= y <= 900: t.C += 0.003

        # ── Christianity ──
        if "Christ" in n:
            if 30 <= y <= 100: t.C += 0.018
            constantine_disabled = mod.get('no_constantine', False)
            if y == 310 and not constantine_disabled:
                t.S += 0.10; t.C += 0.05
            if 325 <= y <= 500: t.I += 0.005
            if y == 1054: t.S *= 0.94
            reformation_disabled = mod.get('no_reformation', False)
            if y == 1520 and not reformation_disabled:
                t.C += 0.04; t.I += 0.04
            if 1500 <= y <= 1800: t.fol += 0.0015

        # ── Islam ──
        if "Islam" in n:
            if 622 <= y <= 660: t.C += 0.028; t.S += 0.02
            if 700 <= y <= 900: t.I += 0.007; t.C += 0.003
            if y == 1258: t.S *= 0.82

        # ── Science ──
        if "Sci" in n:
            printing_boost = mod.get('no_printing', 0.0)
            if y == 1500: t.I += 0.03 * (1 - printing_boost)
            if y == 1690: t.I += 0.05; t.C += 0.03
            if y == 1790: t.S += 0.05; t.C += 0.04
            if y == 1860: t.I += 0.05
            if 1900 <= y <= 2050:
                t.S += 0.004; t.C += 0.005; t.I += 0.007

    def run(self) -> 'HistoryEngine':
        for y in self.years:
            for t in self.traditions:
                if y >= t.birth and not t.alive:
                    t.alive = True
                    rng = random.Random(hash((t.name, y)))
                    t.S = 0.04 + rng.uniform(0, 0.04)
                    t.C = 0.04 + rng.uniform(0, 0.04)
                    t.I = 0.03 + rng.uniform(0, 0.03)
                    t.fol = 0.005

                if not t.alive:
                    for h in [t.h_cd, t.h_fol, t.h_s, t.h_c, t.h_i]:
                        h.append(0.0)
                    t.h_lvl.append(0)
                    continue

                age = max(1, y - t.birth)
                gm = 1.0 / (1.0 + 8e-5 * age)
                for attr, rate in [('S', t.sg), ('C', t.cg), ('I', t.ig)]:
                    v = getattr(t, attr)
                    dv = (rate * gm + random.gauss(0, 0.0015)) * (1 - v * 0.25)
                    setattr(t, attr, float(np.clip(v + dv, 0.01, 1.0)))

                self._catalyze(t, y)
                for attr in ['S', 'C', 'I']:
                    setattr(t, attr, float(np.clip(getattr(t, attr), 0.01, 1.0)))

                t.fol += t.cd * 0.0018 * (1 - t.fol) * (1 + t.level * 0.4)
                t.fol = float(np.clip(t.fol, 0.001, 0.95))

                old = t.level
                if   t.cd >= t.tp3 and t.level < 3: t.level = 3
                elif t.cd >= t.tp2 and t.level < 2: t.level = 2
                elif t.cd >= t.tp1 and t.level < 1: t.level = 1
                if t.level > old:
                    self.tp_log.append(TPEvent(y, t.name, old, t.level, t.cd))
                    t.fol = min(0.95, t.fol * (1 + 0.25 * t.level))

                t.h_cd.append(t.cd); t.h_fol.append(t.fol)
                t.h_lvl.append(t.level); t.h_s.append(t.S)
                t.h_c.append(t.C); t.h_i.append(t.I)

            alive = [tr for tr in self.traditions if tr.alive]
            total = sum(tr.fol for tr in alive)
            if total > 1.0:
                for tr in alive: tr.fol /= (total * 1.02)

        return self

    def get_final_cds(self) -> Dict[str, float]:
        return {t.name: t.cd for t in self.traditions if t.alive}

    def get_level_at(self, year: int) -> Dict[str, int]:
        idx = max(0, min((year - self.t0) // self.dt,
                         len(self.years) - 1))
        result = {}
        for t in self.traditions:
            if t.alive and idx < len(t.h_lvl):
                result[t.name] = t.h_lvl[idx]
        return result


