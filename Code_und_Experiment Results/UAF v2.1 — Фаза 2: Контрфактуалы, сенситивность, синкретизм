class SyncreticEngine(HistoryEngine):
    """
    Расширенная модель: традиции обмениваются информацией
    при контакте (синкретизм). Порождает дочерние традиции.
    """

    # Определяем связи: (parent1, parent2, child, year_range, transfer_rate)
    SYNCRETIC_LINKS = [
        ("Judaism", "Chinese phil.", "Hinduism", (-400, 200), 0.001),
        ("Hinduism", "Buddhism", "Chinese phil.", (-200, 500), 0.002),
        ("Judaism", "Hinduism", "Christianity", (-50, 200), 0.003),
        ("Christianity", "Judaism", "Islam", (500, 750), 0.002),
        ("Chinese phil.", "Buddhism", "Buddhism", (100, 600), 0.002),
        ("Christianity", "Science", "Science", (1400, 1700), 0.003),
        ("Islam", "Hinduism", "Sikhism", (1400, 1600), 0.001),
    ]

    def __init__(self, syncretism_on: bool = True, **kwargs):
        super().__init__(**kwargs)
        self.syn_on = syncretism_on
        self.transfer_log = []

    def _catalyze(self, t, y):
        super()._catalyze(t, y)

        if not self.syn_on:
            return

        # Синкретический трансфер
        for p1_name, p2_name, target_name, (y0, y1), rate in self.SYNCRETIC_LINKS:
            if t.name != target_name:
                continue
            if not (y0 <= y <= y1):
                continue

            parents_alive = []
            for other in self.traditions:
                if other.name in [p1_name, p2_name] and other.alive:
                    parents_alive.append(other)

            if len(parents_alive) >= 1:
                # Информационный трансфер: I ребёнка растёт
                # пропорционально I родителей
                total_parent_I = sum(p.I for p in parents_alive)
                boost = rate * total_parent_I / len(parents_alive)
                t.I += boost
                # Небольшой буст каталиса (миссионерство)
                t.C += boost * 0.3

                if boost > 0.001:
                    self.transfer_log.append(
                        (y, t.name, [p.name for p in parents_alive], boost)
                    )


def run_syncretism_comparison():
    """Сравнение: с синкретизмом vs без"""
    print("\n" + "=" * 80)
    print("  ЭКСПЕРИМЕНТ: ВЛИЯНИЕ СИНКРЕТИЗМА")
    print("=" * 80)

    eng_off = SyncreticEngine(syncretism_on=False, label="no_syncretism")
    eng_off.run()

    eng_on = SyncreticEngine(syncretism_on=True, label="with_syncretism")
    eng_on.run()

    print("\n  Сравнение итоговых CD (2050):")
    print("  " + "-" * 60)
    print(f"  {'Традиция':<22s} | {'Без синкр.':>10s}"
          f" | {'С синкр.':>10s} | {'Дельта':>10s}")
    print("  " + "-" * 60)

    for t_off, t_on in zip(eng_off.traditions, eng_on.traditions):
        if t_off.alive:
            d = t_on.cd - t_off.cd
            sign = "+" if d >= 0 else ""
            print(f"  {t_off.name:<22s} | {t_off.cd:10.3f}"
                  f" | {t_on.cd:10.3f} | {sign}{d:9.3f}")

    print("  " + "-" * 60)
    print("\n  Лог синкретических трансферов:")
    print("  " + "-" * 60)
    for y, target, parents, boost in eng_on.transfer_log[:15]:
        ys = f"{abs(y)} BCE" if y < 0 else f"{y} CE"
        print(f"  {ys:>10s} | {', '.join(parents):>25s}"
              f" -> {target:<18s} | boost={boost:.4f}")

    print("=" * 80)
    return eng_off, eng_on


