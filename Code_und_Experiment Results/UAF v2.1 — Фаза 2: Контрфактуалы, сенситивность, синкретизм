#  ЭКСПЕРИМЕНТ 2: СЕНСИТИВНОСТЬ (One-at-a-time sensitivity)
# ═══════════════════════════════════════════════════════════════════════

def sensitivity_analysis():
    """
    Для каждой традиции варьируем S, C, I по отдельности (±40%)
    и смотрим, как меняется итоговый CD.
    Это проверяет гипотезу UAF: геом. среднее чувствительно к минимуму.
    """
    print("\n" + "=" * 80)
    print("  АНАЛИЗ СЕНСИТИВНОСТИ  ·  S, C, I variation ±40%")
    print("=" * 80)

    base_eng = HistoryEngine(label="baseline")
    base_eng.run()

    perturbations = np.linspace(-0.4, 0.4, 9)  # -40%..+40%
    sensitivity_data = {}

    for t_base in base_eng.traditions:
        if not t_base.alive:
            continue

        s_curve = []
        c_curve = []
        i_curve = []

        for delta in perturbations:
            for component in ['S', 'C', 'I']:
                eng = HistoryEngine(label=f"sens_{t_base.name}_{component}")
                # Найти нужную традицию и изменить growth rate
                t_mod = [x for x in eng.traditions
                         if x.name == t_base.name][0]
                if component == 'S':
                    t_mod.sg *= (1 + delta)
                elif component == 'C':
                    t_mod.cg *= (1 + delta)
                else:
                    t_mod.ig *= (1 + delta)

                eng.run()
                t_result = [x for x in eng.traditions
                            if x.name == t_base.name][0]
                cd_val = t_result.cd if t_result.alive else 0.0

                if component == 'S':
                    s_curve.append(cd_val)
                elif component == 'C':
                    c_curve.append(cd_val)
                else:
                    i_curve.append(cd_val)

        sensitivity_data[t_base.name] = {
            'perturbations': perturbations,
            'S': np.array(s_curve),
            'C': np.array(c_curve),
            'I': np.array(i_curve),
            'base_cd': t_base.cd,
            'color': t_base.color,
        }

    # Печать результатов
    print("\n  Эластичность CD к изменению growth rate:")
    print("  " + "-" * 70)
    print(f"  {'Традиция':<22s} | {'dCD/dS':>8s} | {'dCD/dC':>8s}"
          f" | {'dCD/dI':>8s} | {'Мин.компонент':>14s}")
    print("  " + "-" * 70)

    for tname, data in sensitivity_data.items():
        base = data['base_cd']
        # Эластичность: (dCD/CD) / (dg/g) при delta=0
        idx_center = len(perturbations) // 2
        dS = (data['S'][idx_center + 1] - data['S'][idx_center - 1]) / \
             (perturbations[idx_center + 1] - perturbations[idx_center - 1])
        dC = (data['C'][idx_center + 1] - data['C'][idx_center - 1]) / \
             (perturbations[idx_center + 1] - perturbations[idx_center - 1])
        dI = (data['I'][idx_center + 1] - data['I'][idx_center - 1]) / \
             (perturbations[idx_center + 1] - perturbations[idx_center - 1])

        # Нормализуем к процентам
        eS = dS / max(base, 0.01)
        eC = dC / max(base, 0.01)
        eI = dI / max(base, 0.01)

        # Какой компонент даёт наибольшую эластичность?
        elasts = {'S': eS, 'C': eC, 'I': eI}
        min_comp = min(elasts, key=elasts.get)
        # UAF предсказание: наибольшая эластичность = у слабейшего
        # (геом. среднее: d(xy*z)^(1/3)/dx ∝ 1/x при фикс. y,z)

        print(f"  {tname:<22s} | {eS:+7.3f}  | {eC:+7.3f}  "
              f"| {eI:+7.3f}  | -> {min_comp}")

    print("  " + "-" * 70)
    print("  UAF-предсказание: наибольшая эластичность у СЛАБЕЙШЕГО")
    print("  компонента (геом. среднее: d(xyz)^(1/3)/dx ~ 1/x)")
    print("=" * 80)

    return sensitivity_data, perturbations


