#  ЧАСТЬ C: Active Experimenter
# ═══════════════════════════════════════════════════════════════════════

def active_experimenter(macro: MacroHistoryModel):
    print(f"\n{'='*72}")
    print("  АКТИВНЫЙ ЭКСПЕРИМЕНТАТОР  ·  UAF Active Experimenter")
    print(f"{'='*72}")

    exps = []

    # 1. Дисбалансы
    for t in macro.traditions:
        if not t.alive:
            continue
        vals = {'S': t.S, 'C': t.C, 'I': t.I}
        weak = min(vals, key=vals.get)
        strong = max(vals, key=vals.get)
        gap = vals[strong] - vals[weak]
        if gap > 0.12:
            exps.append(
                f"ДИСБАЛАНС: {t.name}\n"
                f"    Слабое: {weak}={vals[weak]:.2f}, "
                f"Сильное: {strong}={vals[strong]:.2f} (gap={gap:.2f})\n"
                f"    -> Усиление {weak} даст макс. прирост CD "
                f"(геом. среднее чувствительно к минимуму)"
            )

    # 2. Контрфактуал
    exps.append(
        "КОНТРФАКТУАЛ: мир без Осевого времени\n"
        "    -> Убрать catalytic boost 800-200 до н.э.\n"
        "    -> Предсказание: L2 для буддизма/иудаизма на 400-600 лет позже"
    )

    # 3. Скорость замыкания
    speeds = []
    for t in macro.traditions:
        l2_events = [e for e in macro.tp_log
                     if e.name == t.name and e.new == 2]
        if l2_events:
            dt_to_l2 = l2_events[0].year - t.birth_year
            speeds.append(f"    {t.name:<24s}: {dt_to_l2:>5d} лет до L2")
    if speeds:
        exps.append(
            "СКОРОСТЬ ЗАМЫКАНИЯ (birth -> L2):\n" +
            "\n".join(speeds) + "\n"
            "    -> Поздние традиции замыкаются быстрее "
            "(наследуют инфраструктуру)"
        )

    for i, e in enumerate(exps, 1):
        print(f"\n  Эксперимент #{i}:  {e}")
    print(f"\n{'='*72}")


