            ((1929, 1933), {'EC': (+0.08, 'p'), 'ID': (+0.05, 'n'), 'ST': (+0.03, 'p')}),
            ((1939, 1945), {'R': (+0.05, 'p'), 'ID': (+0.05, 'n'), 'ST': (+0.05, 'p'),
                            'EC': (+0.05, 'p'), 'TC': (+0.05, 'p')}),
            ((1947, 1991), {'TC': (+0.01, 'p'), 'ID': (+0.008, 'p'), 'ST': (+0.006, 'p')}),
            ((1991, 2000), {'ST': (0, 'p', '*0.97'), 'ID': (+0.015, 'p')}),
            ((2010, 2015), {'EC': (+0.02, 'p'), 'ID': (+0.025, 'p'), 'R': (+0.015, 'p')}),
            ((2025, 2080), {'R': (+0.004, 'p'), 'TC': (+0.005, 'p'), 'ST': (+0.003, 'p')}),
        ]

        for (y0, y1), effects in injections:
            if y0 <= y <= y1:
                for k, eff in effects.items():
                    if k not in L:
                        continue
                    val = eff[0] if isinstance(eff[0], (int, float)) else 0
                    mode = eff[1] if len(eff) > 1 else 'p'
                    extra = eff[2] if len(eff) > 2 else 0

                    if mode == 'p':
                        L[k].pressure += val
                        if extra: L[k].catalysis += extra
                    elif mode == 'n':
                        L[k].narrative += val
                        if extra: L[k].catalysis += extra
                    elif mode == 'c':
                        L[k].catalysis += val if val else extra
                    elif mode == '*':
                        pass

        # Специальные точечные инъекции
        if y == 1962:
            L['ST'].catalysis += 0.07
            L['TC'].catalysis += 0.05
        if y == 2001:
            L['ID'].narrative += 0.05
            L['ID'].catalysis += 0.04
            L['R'].catalysis += 0.02
        if y == 2022:
            L['ST'].catalysis += 0.06
            L['ID'].narrative += 0.05
            L['R'].catalysis += 0.04
            L['TC'].catalysis += 0.03

        # Деэскалационные механизмы (1945–2020)
        if 1945 <= y <= 2020:
            L['ST'].pressure = max(0.01, L['ST'].pressure - 0.003)
            L['R'].catalysis = max(0.01, L['R'].catalysis - 0.001)

        # Клип
        for loop in self.loops.values():
            loop.pressure  = self._clip(loop.pressure)
            loop.catalysis = self._clip(loop.catalysis)
            loop.narrative = self._clip(loop.narrative)

    def _global_instability(self) -> float:
        cds = [l.cd for l in self.loops.values()]
        base = np.mean(cds)
        hot = sum(1 for cd in cds if cd > 0.45)
        synergy = 1.0 + (hot ** 2) * 0.15
        return float(np.clip(base * synergy, 0, 1))

