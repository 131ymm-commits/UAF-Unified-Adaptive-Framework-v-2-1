            'TC': Loop("Технология",   '#BB44FF', '💡 Технология'),
        }
        self.gi_hist: List[float] = []

    def _clip(self, v: float) -> float:
        return float(np.clip(v, 0.01, 1.0))

    def _dynamics(self, y: int):
        L = self.loops
        # Базовый рост
        for k in CAUSE_KEYS:
            L[k].pressure  += 0.0006 + random.gauss(0, 0.0003)
            L[k].catalysis += 0.0005
            L[k].narrative += 0.0004

        # Циклический экономический (каждые ~50 лет)
        cyc = 0.5 * (1 + np.sin(2 * np.pi * y / 50))
        L['EC'].pressure  += 0.0005 * cyc
        L['EC'].catalysis += 0.0004 * cyc

        # Технологический: экспоненциальный рост
        tr = 0.0003 if y < 1800 else (0.0008 if y < 1950 else 0.0018)
        L['TC'].pressure  += tr
        L['TC'].catalysis += tr * 0.8

    def _inject(self, y: int):
