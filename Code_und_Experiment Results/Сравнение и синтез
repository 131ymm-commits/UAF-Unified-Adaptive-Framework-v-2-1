def war_cd(w: Conflict) -> float:
    """CD = среднее геометрическое всех 5 контуров"""
    vals = [getattr(w, k) for k in CAUSE_KEYS]
    return float(np.clip(np.prod(vals) ** (1/5), 0, 1))

def war_cd_per_loop(w: Conflict) -> Dict[str, float]:
    """CD каждого контура (для радара)"""
    # Каждый контур имеет только одну оценку, поэтому CD ≈ сама оценка
    # Но для совместимости с моделью используем:
    # pressure = оценка, catalysis = 0.7 (базовый), narrative = 0.6 (базовый)
    return {k: float(np.clip(
        (getattr(w, k) * 0.70 * 0.60) ** (1/3), 0, 1
    )) for k in CAUSE_KEYS}

def war_level(w: Conflict) -> str:
    cd = war_cd(w)
    if cd < 0.35: return "L0"
    if cd < 0.45: return "L1"
    if cd < 0.55: return "L2"
    return "L3"


