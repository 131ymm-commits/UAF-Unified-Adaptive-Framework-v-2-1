                  f" | {w.scale:.2f} ({CAUSE_LABELS[dom][2:]})")

        # Статистика
        cds_all = [war_cd(w) for w in WARS]
        log_cas = np.log1p([w.cas_M for w in WARS])
        r_corr = np.corrcoef(cds_all, log_cas)[0, 1]
        print(f"\n  📊 Корреляция CD ↔ log(потери): r = {r_corr:.3f}")
        print(f"  📊 Конфликтов с CD ≥ 0.50: {sum(1 for c in cds_all if c >= 0.50)}/{len(WARS)}")
        print(f"  📊 Конфликтов L3 (CD ≥ 0.55): {sum(1 for c in cds_all if c >= 0.55)}/{len(WARS)}")

        # ── Динамический слой: симуляция ──
        print(f"\n📈 СЛОЙ 2: ДИНАМИЧЕСКАЯ СИМУЛЯЦИЯ ({self.T0} — {self.T1})")
        print("─" * 70)

        for y in self.years:
            self._dynamics(y)
            self._inject(y)
            self.gi_hist.append(self._global_instability())
            for loop in self.loops.values():
                loop.record()

        # Финальные CD
        print(f"\n  📊 ФИНАЛЬНЫЕ CD КОНТУРОВ ({self.T1}):")
        for key, loop in sorted(self.loops.items(), key=lambda x: -x[1].cd):
            bar = "█" * int(loop.cd * 20)
            print(f"    {loop.label:<22s} CD={loop.cd:.3f} │ {bar}")

        gi_final = self.gi_hist[-1]
        print(f"\n  🌍 Глобальный индекс нестабильности: {gi_final:.3f}")
        status = "🔴 КРИТИЧ." if gi_final > 0.65 else ("⚠ ВЫСОКИЙ" if gi_final > 0.50 else "↗ умеренный")
        print(f"     Статус: {status}")

        # Топ пики
        gi_arr = np.array(self.gi_hist)
        peaks = []
        for i in range(2, len(gi_arr) - 2):
            if gi_arr[i] > gi_arr[i-1] and gi_arr[i] > gi_arr[i+1] and gi_arr[i] > 0.42:
                peaks.append((self.years[i], gi_arr[i]))
        peaks.sort(key=lambda x: -x[1])

        print(f"\n  ⚡ ТОП-10 ПИКОВ НЕСТАБИЛЬНОСТИ:")
        for yr, gi in peaks[:10]:
            yr_s = f"{abs(yr)} до н.э." if yr < 0 else f"{yr} н.э."
            bar = "█" * int(gi * 25)
            closest = min(WARS, key=lambda w: abs(w.year - yr))
            print(f"    {yr_s:>12s} │ GI={gi:.3f} │ {bar:<20s} │ ≈{closest.name}")

        # ВМВ анализ
        idx_ww2 = min(range(len(self.years)), key=lambda i: abs(self.years[i] - 1940))
        print(f"\n  🔍 ВМВ (1939–1945):")
        for k in CAUSE_KEYS:
            cd_v = self.loops[k].hist_cd[idx_ww2]
            print(f"    {self.loops[k].label:<22s} CD={cd_v:.3f}")
        print(f"    {'─'*45}")
        print(f"    Глобальный GI: {self.gi_hist[idx_ww2]:.3f}")
        print(f"    Вывод: ВСЕ 5 контуров пересекли порог → L3 (тотальная)")

        # Проекция
