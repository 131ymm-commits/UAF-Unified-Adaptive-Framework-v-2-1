@dataclass
class ConflictLoop:
    """Один тип причины конфликта как AdaptiveLoop (S+C+I)."""
    name:    str
    color:   str
    label:   str
    pressure:  float = 0.05
    catalysis: float = 0.05
    narrative: float = 0.05
    hist_cd:   List[float] = field(default_factory=list)
    
    @property
    def cd(self) -> float:
        return float(np.clip(
            (self.pressure * self.catalysis * self.narrative) ** (1/3), 0, 1
        ))
    
    def record(self):
        self.hist_cd.append(self.cd)


class WarConflictUAF:
    T0, T1, DT = -500, 2080, 5
    
