        L['identity'].pressure  = np.clip(L['identity'].pressure  + 0.0006 + random.gauss(0,0.0006), 0, 1)
        L['identity'].catalysis = np.clip(L['identity'].catalysis + 0.0005, 0, 1)
        L['identity'].narrative = np.clip(L['identity'].narrative + 0.0007, 0, 1)
        
        L['structural'].pressure  = np.clip(L['structural'].pressure  + 0.0005 + random.gauss(0,0.0004), 0, 1)
        L['structural'].catalysis = np.clip(L['structural'].catalysis + 0.0004, 0, 1)
        L['structural'].narrative = np.clip(L['structural'].narrative + 0.0003, 0, 1)
        
        cycle = 0.5 * (1 + np.sin(2 * np.pi * y / 50))
        L['econ'].pressure  = np.clip(L['econ'].pressure  + 0.0004 * (1 + cycle) + random.gauss(0,0.0006), 0, 1)
        L['econ'].catalysis = np.clip(L['econ'].catalysis + 0.0005 * cycle, 0, 1)
        L['econ'].narrative = np.clip(L['econ'].narrative + 0.0004, 0, 1)
        
        tech_rate = 0.0003 if y < 1800 else (0.0008 if y < 1950 else 0.0020)
        L['tech'].pressure  = np.clip(L['tech'].pressure  + tech_rate + random.gauss(0,0.0003), 0, 1)
        L['tech'].catalysis = np.clip(L['tech'].catalysis + tech_rate * 0.8, 0, 1)
        L['tech'].narrative = np.clip(L['tech'].narrative + tech_rate * 0.6, 0, 1)
    
    def _inject(self, y: int):
