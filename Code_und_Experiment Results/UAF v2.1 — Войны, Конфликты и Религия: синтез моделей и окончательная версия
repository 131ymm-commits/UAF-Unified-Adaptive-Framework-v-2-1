        if y == 1962:
            L['structural'].catalysis += 0.080; L['tech'].catalysis       += 0.060
        if 1991 <= y <= 2000:
            L['structural'].pressure  *= 0.970; L['identity'].pressure    += 0.020
        if y == 2001:
            L['identity'].narrative   += 0.060; L['identity'].catalysis   += 0.050; L['resource'].catalysis   += 0.030
        if 2010 <= y <= 2015:
            L['econ'].pressure        += 0.025; L['identity'].pressure    += 0.030; L['resource'].pressure    += 0.020
        if y == 2022:
            L['structural'].catalysis += 0.070; L['identity'].narrative   += 0.065; L['resource'].catalysis   += 0.050; L['tech'].catalysis       += 0.040
        if y >= 2025:
            L['resource'].pressure    += 0.004; L['tech'].pressure        += 0.005; L['tech'].catalysis       += 0.004; L['structural'].pressure  += 0.003
        if 1945 <= y <= 2020:
            L['structural'].pressure  = max(0.01, L['structural'].pressure - 0.003)
            L['resource'].catalysis   = max(0.01, L['resource'].catalysis  - 0.001)
        
        for loop in self.loops.values():
            loop.pressure  = float(np.clip(loop.pressure,  0.01, 1.0))
            loop.catalysis = float(np.clip(loop.catalysis, 0.01, 1.0))
            loop.narrative = float(np.clip(loop.narrative, 0.01, 1.0))
    
    def _global_instability(self) -> float:
        cds = [l.cd for l in self.loops.values()]
        base = np.mean(cds)
        hot = sum(1 for cd in cds if cd > 0.45)
        synergy = 1.0 + (hot ** 2) * 0.15
        return float(np.clip(base * synergy, 0, 1))
    
    def run(self):
        print("═" * 72)
        print("  UAF v2.1  ·  ВОЙНЫ, КОНФЛИКТЫ, РЕЛИГИЯ")
        print("  Синтез: 5 контуров + историческая динамика")
        print("═" * 72)
        
        for y in self.years:
            self._base_dynamics(y)
            self._inject(y)
            self.global_instability.append(self._global_instability())
            L = self.loops
            rt = L['identity'].narrative * 0.6 + L['identity'].pressure * 0.4
            self.religion_temp.append(float(np.clip(rt, 0, 1)))
            for loop in self.loops.values():
                loop.record()
        self._report()
    
    def _report(self):
        Y = self.years
        print(f"\n📊 ФИНАЛЬНЫЕ CD КОНТУРОВ ({self.T1} н.э.):")
        print("─" * 72)
        for key, loop in sorted(self.loops.items(), key=lambda x: -x[1].cd):
            bar = "█" * int(loop.cd * 20)
            print(f"  {loop.label:<22s} CD={loop.cd:.3f} │ {bar}")
        gi_final = self.global_instability[-1]
        print(f"\n  🌍 Глобальный индекс нестабильности: {gi_final:.3f}")
        gi_arr = np.array(self.global_instability)
        peaks = []
        for i in range(2, len(gi_arr)-2):
            if gi_arr[i] > gi_arr[i-1] and gi_arr[i] > gi_arr[i+1] and gi_arr[i] > 0.45:
                peaks.append((Y[i], gi_arr[i]))
        peaks.sort(key=lambda x: -x[1])
        print(f"\n⚡ ТОП ПИКОВ НЕСТАБИЛЬНОСТИ:")
        print("─" * 72)
        for yr, gi in peaks[:12]:
            yl = f"{abs(yr)} до н.э." if yr < 0 else f"{yr} н.э."
            closest = min(CONFLICTS, key=lambda c: abs(c[1] - yr))
            print(f"  {yl:>12s} │ GI={gi:.3f} │ ≈{closest[0]}")
        print(f"\n🔮 ПРОЕКЦИЯ:")
        for yr in [2025, 2050, 2080]:
            idx = self.years.index(yr)
            gi = self.global_instability[idx]
            print(f"  {yr}: GI={gi:.3f} {'🔴' if gi>0.65 else '⚠'}")
        print("\n🔬 ACTIVE EXPERIMENTER:")
        print("  EXP-1: возоб. энергия → снижение resource.pressure")
        print("  EXP-2: регулирование соцсетей → снижение identity.catalysis")
        print("  EXP-3: усиление междунар. институтов → снижение structural.pressure")
        print("  EXP-4: контроль ИИ/дронов → снижение tech.catalysis")
    
    def plot(self):
