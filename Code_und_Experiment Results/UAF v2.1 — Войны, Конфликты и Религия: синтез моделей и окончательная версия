    def _base_dynamics(self, y: int):
        L = self.loops
        L['resource'].pressure  = np.clip(L['resource'].pressure  + 0.0008 + random.gauss(0,0.0005), 0, 1)
        L['resource'].catalysis = np.clip(L['resource'].catalysis + 0.0006, 0, 1)
