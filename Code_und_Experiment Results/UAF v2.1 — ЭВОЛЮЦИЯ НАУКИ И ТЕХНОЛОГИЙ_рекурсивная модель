        ax.grid(True, alpha=0.12)
        
        # ── P3: MultiLevel ──
        ax = axes[2]
        for i, s in enumerate(self.sectors):
            off = i * 0.07
            yv = [l + off for l in s.hist['level']]
            ax.step(Y, yv, color=s.color, lw=1.8, where='post',
                    label=s.name)
        ax.set(xlim=(self.T0, self.T1), title='P3 · MultiLevel L0→L3',
               ylabel='Уровень')
        ax.set_yticks([0, 1, 2, 3])
        ax.set_yticklabels(['L0 Прото', 'L1 Организ.', 'L2 Парадигма', 'L3 Универс.'],
                           fontsize=7)
        ax.legend(fontsize=5.5, ncol=3, framealpha=0.4, loc='upper left')
        ax.grid(True, alpha=0.12)
        
        # ── P4/P5: S-C-I для двух секторов ──
        for idx, nm, lbl in [(3, "Информатика", "💻 Информатика"),
                             (4, "ИИ",           "🤖 ИИ")]:
            ax = axes[idx]
            s = next(x for x in self.sectors if x.name == nm)
            ax.plot(Y, s.hist['S'], '#4488ff', lw=1.5, label='S Структура')
            ax.plot(Y, s.hist['C'], '#ff4444', lw=1.5, label='C Катализ')
            ax.plot(Y, s.hist['I'], '#44ff88', lw=1.5, label='I Информация')
            ax.plot(Y, s.hist['cd'], '#fff', lw=2, ls='--', label='CD')
            ax.set(xlim=(max(s.birth, self.T0), self.T1), ylim=(0, 1.05),
                   title=f'P{idx+1} · S-C-I: {lbl}', ylabel='Значение')
            ax.legend(fontsize=7, framealpha=0.5)
            ax.grid(True, alpha=0.12)
        
        # ── P6: Карта TP ──
        ax = axes[5]
        mkr = {1: 'o', 2: 's', 3: '*'}
        for y, nm, lv, cd in self.tp_events:
            s = next(x for x in self.sectors if x.name == nm)
            ax.scatter(y, cd, c=s.color, s=70+lv*80,
                       marker=mkr.get(lv, 'o'),
                       edgecolors='white', lw=0.7, zorder=5)
            ax.annotate(f"{nm[:8]}→L{lv}", (y, cd), fontsize=5,
                        color='#aaa', rotation=30, xytext=(4, 4),
                        textcoords='offset points')
        for lv, yv, c in [(1, TP[1], '#00ffff'), (2, TP[2], '#ff9900'), (3, TP[3], '#ff3333')]:
            ax.axhline(yv, color=c, alpha=0.3, ls='--')
        ax.set(xlim=(self.T0, self.T1), ylim=(0, 1.05),
               title='P6 · Карта TippingPoints', ylabel='CD')
        ax.grid(True, alpha=0.12)
        
        # ── P7: Meta-awareness (ОСОЗНАННОСТЬ) ──
        ax = axes[6]
        for s in self.sectors:
            ax.plot(Y, s.hist['meta'], color=s.color, lw=1.6, alpha=0.85,
                    label=f"{s.icon} {s.name}")
        ax.set(xlim=(self.T0, self.T1), ylim=(0, 1.05),
               title='P7 · Meta-awareness (осознание собственных паттернов)',
               ylabel='Meta-awareness')
        ax.legend(fontsize=5.5, ncol=3, framealpha=0.4, loc='upper left')
        ax.grid(True, alpha=0.12)
        
        # ── P8: Self-acceleration ──
        ax = axes[7]
        for s in self.sectors:
            accel_vals = [1 + a for a in s.hist['accel']]
            ax.plot(Y, accel_vals, color=s.color, lw=1.6, alpha=0.85,
                    label=f"{s.icon} {s.name}")
        ax.axhline(1.0, color='white', alpha=0.2, ls='--')
        ax.text(self.T0+50, 1.02, '×1 = нет ускорения',
                fontsize=7, color='#888')
        ax.set(xlim=(self.T0, self.T1),
               title='P8 · Self-acceleration (рекурсивный буст)',
               ylabel='Множитель ускорения')
        ax.legend(fontsize=5.5, ncol=3, framealpha=0.4, loc='upper left')
        ax.grid(True, alpha=0.12)
        
        # ── P9: Межсекторные потоки ──
        ax = axes[8]
        # Агрегация по 50-летним бинам
        bin_size = 50
        bins = list(range(self.T0, self.T1+1, bin_size))
        flow_by_bin = [0.0] * len(bins)
        for cf in self.cross_flows:
            idx = min((cf.year - self.T0) // bin_size, len(bins)-1)
            if 0 <= idx < len(bins):
                flow_by_bin[idx] += cf.flow
        
        ax.bar(bins, flow_by_bin, width=bin_size*0.8,
               color='#cc66ff', alpha=0.6)
        ax.plot(bins, flow_by_bin, color='#cc66ff', lw=1.5, alpha=0.9)
        ax.set(xlim=(self.T0, self.T1),
               title='P9 · Межсекторные информационные потоки',
               ylabel='Суммарный трансфер')
        ax.grid(True, alpha=0.12)
        
        # ── P10: Фазовое пространство S–C (финал) ──
        ax = axes[9]
        ss = np.linspace(0.01, 1.0, 300)
        for cd_v, cl in [(TP[1], '#00ffff'), (TP[2], '#ff9900'), (TP[3], '#ff3333')]:
            for iv in [0.5, 0.8, 1.0]:
                cc = cd_v**3 / (ss * iv + 1e-9)
                cc = np.where(cc <= 1.0, cc, np.nan)
                ax.plot(ss, cc, color=cl, alpha=0.10, lw=0.6)
        for s in self.sectors:
            if s.alive:
                ax.scatter(s.S, s.C, s=s.I*800+50,
                           c=s.color, edgecolors='white', alpha=0.9,
                           lw=1, zorder=5)
                ax.annotate(f"{s.icon}{s.name[:8]}", (s.S, s.C),
                            fontsize=6.5, color=s.color, ha='center',
                            xytext=(0, 10), textcoords='offset points')
        ax.set(xlim=(0, 1.1), ylim=(0, 1.1),
               title='P10 · Фазовое S–C (размер=I)', xlabel='S', ylabel='C')
        ax.grid(True, alpha=0.12)
        
        # ── P11: Итоговый CD ──
        ax = axes[10]
        alive = sorted([s for s in self.sectors if s.alive],
                       key=lambda x: x.cd)
        names = [f"{s.icon} {s.name}" for s in alive]
        cds   = [s.cd for s in alive]
        cols  = [s.color for s in alive]
        ax.barh(range(len(names)), cds, color=cols, alpha=0.8,
                edgecolor='white', linewidth=0.5)
        ax.set_yticks(range(len(names)))
        ax.set_yticklabels(names, fontsize=7.5)
        for i, (cd, s) in enumerate(zip(cds, alive)):
            ax.text(cd+0.01, i, f'L{s.level} {cd:.3f}', va='center',
                    fontsize=7, color=TXT)
        for xv, c in [(TP[1], '#00ffff'), (TP[2], '#ff9900'), (TP[3], '#ff3333')]:
            ax.axvline(xv, color=c, alpha=0.3, ls='--')
        ax.set(xlim=(0, 1.15), title='P11 · Итоговый CD', xlabel='CD')
        ax.grid(True, alpha=0.12, axis='x')
        
        # ── P12: Radar (топ-5 по meta-awareness) ──
        ax12 = fig.add_subplot(gs[4, 2], polar=True)
        ax12.set_facecolor(PANEL)
        cats = ['S', 'C', 'I', 'Meta', 'Accel']
        N_c = len(cats)
        angles = [n / N_c * 2 * np.pi for n in range(N_c)] + [0]
        
        top5 = sorted([s for s in self.sectors if s.alive],
                      key=lambda x: x.self_acceleration, reverse=True)[:5]
        for s in top5:
            vals = [s.S, s.C, s.I, s.meta_awareness,
                    min(1.0, s.self_acceleration / 1.5)]
            vals += vals[:1]
            ax12.plot(angles, vals, color=s.color, lw=1.3, alpha=0.85)
            ax12.fill(angles, vals, color=s.color, alpha=0.06)
        
        ax12.set_xticks(angles[:-1])
        ax12.set_xticklabels(cats, size=7.5, color=TXT)
        ax12.set_yticks([0.25, 0.50, 0.75])
        ax12.set_yticklabels(['0.25', '0.50', '0.75'], size=5.5, color=DIM)
        ax12.tick_params(colors=DIM)
        ax12.set_title('P12 · Радар S-C-I-Meta (топ-5 рекурсии)',
                       pad=15, fontsize=8, color=TXT)
        ax12.spines['polar'].set_edgecolor(GRID)
        ax12.yaxis.grid(True, color=GRID, alpha=0.3)
        ax12.xaxis.grid(True, color=GRID, alpha=0.3)
        
        patches = [mpatches.Patch(color=s.color, label=f"{s.icon} {s.name}")
                   for s in top5]
        ax12.legend(handles=patches, fontsize=5.5, loc='upper right',
                    bbox_to_anchor=(1.5, 1.15), framealpha=0.5)
        
        plt.savefig('uaf_science_tech.png', dpi=140,
                    bbox_inches='tight', facecolor=fig.get_facecolor())
        plt.show()
        print("\n✅ 12 панелей · Файл: uaf_science_tech.png")


