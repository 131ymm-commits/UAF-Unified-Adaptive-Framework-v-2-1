# KNOWLEDGE SECTOR — единый абстрактный контур для науки/техники
# ══════════════════════════════════════════════════════════════════════

@dataclass
class KnowledgeSector:
    """
    Сектор знаний (наука, техника, медицина и т.д.)
    
    S = Структура   — институты, оборудование, методы
    C = Катализ     — скорость распространения идей
    I = Информация  — накопленный объём знаний
    
    Ключевое отличие от культурной модели:
    наука имеет ОСОЗНАННЫЙ компонент обратной связи —
    она исследует собственные механизмы замыкания.
    """
    name:       str
    birth:      int        # условный год «рождения»
    color:      str
    icon:       str = '●'
    
    # Базовые скорости роста
    sg: float = 0.004
    cg: float = 0.004
    ig: float = 0.004
    
    # Состояние
    S: float = 0.02
    C: float = 0.02
    I: float = 0.02
    level: int = 0
    alive: bool = False
    
    # Рекурсия: осознание собственных паттернов
    meta_awareness: float = 0.0    # 0..1: насколько сектор изучает сам себя
    self_acceleration: float = 0.0 # ускорение роста из-за рефлексии
    
    # Последователи / влияние
    impact: float = 0.005
    
    # История
    hist: Dict[str, List[float]] = field(default_factory=lambda: {
        'cd': [], 'S': [], 'C': [], 'I': [],
        'impact': [], 'level': [], 'meta': [], 'accel': [],
    })

    @property
    def cd(self) -> float:
        return float(np.clip((self.S * self.C * self.I) ** (1/3), 0, 1))

    def check_level(self) -> bool:
        old = self.level
        c = self.cd
        if c >= TP[3] and self.level < 3: self.level = 3
        elif c >= TP[2] and self.level < 2: self.level = 2
        elif c >= TP[1] and self.level < 1: self.level = 1
        return self.level > old

    def activate(self):
        self.alive = True
        self.S = 0.03 + random.uniform(0, 0.03)
        self.C = 0.03 + random.uniform(0, 0.03)
        self.I = 0.02 + random.uniform(0, 0.02)
        self.impact = 0.005

    def record(self):
        self.hist['cd'].append(self.cd)
        self.hist['S'].append(self.S)
        self.hist['C'].append(self.C)
        self.hist['I'].append(self.I)
        self.hist['impact'].append(self.impact)
        self.hist['level'].append(self.level)
        self.hist['meta'].append(self.meta_awareness)
        self.hist['accel'].append(self.self_acceleration)

    def grow(self, age: int, noise_scale: float = 0.001):
        """Логистический рост с учётом рекурсивного ускорения"""
        gm = 1.0 / (1.0 + 6e-5 * age)
        accel = 1.0 + self.self_acceleration  # рекурсивный буст
        
        for attr, rate in [('S', self.sg), ('C', self.cg), ('I', self.ig)]:
            v  = getattr(self, attr)
            dv = (rate * gm * accel + random.gauss(0, noise_scale)) * (1 - v * 0.20)
            setattr(self, attr, float(np.clip(v + dv, 0.01, 1.0)))

    def update_meta(self):
        """
        РЕКУРСИЯ: сектор «понимает» сам себя.
        
        meta_awareness растёт с CD и уровнем:
        L1: сектор начинает рефлексию ( peer review, методология )
        L2: сектор изучает собственные паттерны роста
        L3: сектор моделирует собственное будущее и управляет им
        
        self_acceleration = f(meta_awareness):
        осознание ускоряет замыкание — положительная обратная связь.
        Но с затуханием: ретроспективное ускорение ограничено.
        """
        if not self.alive:
            return
        
        # Рост осознанности
        cd = self.cd
        if self.level >= 2:
            growth = 0.005 * cd
        elif self.level >= 1:
            growth = 0.002 * cd
        else:
            growth = 0.0005 * cd
        
        self.meta_awareness = float(np.clip(
            self.meta_awareness + growth, 0, 1
        ))
        
        # Ускорение: log-зависимость от осознанности (с насыщением)
        self.self_acceleration = float(np.clip(
            0.6 * np.log1p(3.0 * self.meta_awareness), 0, 1.5
        ))


