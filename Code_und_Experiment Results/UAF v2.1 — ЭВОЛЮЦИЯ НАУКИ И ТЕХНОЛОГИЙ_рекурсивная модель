    # ── Межсекторные потоки ──────────────────────────────────────
    
    def _cross_pollinate(self, y: int):
        """
        Научные революции возникают на стыках секторов.
        Каждый сектор с CD > 0.4 «просачивает» знания в соседние.
        """
        alive = [s for s in self.sectors if s.alive]
        high = [s for s in alive if s.cd > 0.35]
        
        flow_total = 0.0
        for donor in high:
            for recv in alive:
                if donor is recv:
                    continue
                # Поток пропорционален I донора и обратно пропорционален расстоянию
                # между «позициями» секторов в conceptual space
                flow = donor.I * 0.0006 * recv.C
                if flow > 0.0001:
                    recv.I += flow
                    flow_total += flow
                    if flow > 0.002:
                        self.cross_flows.append(
                            CrossFlow(y, donor.name, recv.name, flow,
                                      f"{donor.icon}→{recv.icon}")
                        )
        
        # Конкуренция за «внимание» (ограниченный ресурс)
        total_impact = sum(s.impact for s in alive)
        if total_impact > 1.0:
            for s in alive:
                s.impact /= (total_impact * 1.01)
        
        return flow_total

    # ── Основной цикл ─────────────────────────────────────────────
    
    def run(self):
        print("═" * 72)
        print("  UAF v2.1  ·  ЭВОЛЮЦИЯ НАУКИ И ТЕХНОЛОГИЙ")
        print(f"  Период: {abs(self.T0)} до н.э. — {self.T1} н.э.")
        print("  Секторов: " + " │ ".join(
            f"{s.icon} {s.name}" for s in self.sectors
        ))
        print("═" * 72)
        
        for y in self.years:
            for s in self.sectors:
                if y >= s.birth and not s.alive:
                    s.activate()
                if not s.alive:
                    s.record()
                    continue
                
                age = max(1, y - s.birth)
                s.grow(age)
                self._inject(s, y)
                s.S = float(np.clip(s.S, 0.01, 1.0))
                s.C = float(np.clip(s.C, 0.01, 1.0))
                s.I = float(np.clip(s.I, 0.01, 1.0))
                
                # Рекурсия!
                s.update_meta()
                
                # Влияние
                cd = s.cd
                s.impact += cd * 0.0022 * (1 - s.impact) * (1 + s.level * 0.5)
                s.impact = float(np.clip(s.impact, 0.001, 0.95))
                
                # Tipping Point
                if s.check_level():
                    self.tp_events.append((y, s.name, s.level, cd))
                    s.impact = min(0.95, s.impact * (1 + 0.3 * s.level))
                
                s.record()
            
            self._cross_pollinate(y)
        
        self._report()
    
    def _report(self):
        desc = {1: "Организ. знание", 2: "Парадигма", 3: "Унив. теория"}
        print(f"\n📌 TIPPING POINTS:")
        print("─" * 72)
        for y, nm, lv, cd in self.tp_events:
            yl = f"{abs(y)} до н.э." if y < 0 else f"{y} н.э."
            print(f"  {yl:>14s} │ {nm:<16s} │ → L{lv} │ CD={cd:.3f} │ {desc.get(lv, '')}")
        
        print(f"\n📊 ФИНАЛ ({self.T1} н.э.):")
        print("─" * 72)
        for s in sorted(self.sectors, key=lambda x: x.cd, reverse=True):
            if s.alive:
                meta_bar = "▓" * int(s.meta_awareness * 15)
                print(f"  {s.icon} {s.name:<16s} CD={s.cd:.3f} L{s.level}"
                      f" │ S={s.S:.2f} C={s.C:.2f} I={s.I:.2f}"
                      f" │ Meta={s.meta_awareness:.2f}"
                      f" │ Accel=×{1+s.self_acceleration:.2f}"
                      f" │ {meta_bar}")
        
        # Ключевой вывод: рекурсия
        top = max(self.sectors, key=lambda s: s.self_acceleration if s.alive else 0)
        print(f"\n🔬 КЛЮЧЕВОЙ ВЫВОД:")
        print(f"  Максимальное самускорение: {top.icon} {top.name}")
        print(f"  Meta-awareness: {top.meta_awareness:.3f}")
        print(f"  Self-acceleration: ×{1+top.self_acceleration:.3f}")
        print(f"  ▸ Это означает, что {top.name} ускоряет собственное замыкание")
        print(f"    в {(1+top.self_acceleration):.1f} раза быстрее «слепых» секторов.")
    
